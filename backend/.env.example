# --- App ---
ENVIRONMENT=development
# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local: postgresql://careeros:careeros@localhost:5432/careeros
# Supabase/Neon: use the connection string they give you
DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros

# --- Redis (optional, used for caching AI responses) ---
REDIS_URL=redis://localhost:6379/0

# --- Server-managed AI Provider (optional) ---
# Most users connect their own provider key in Dashboard → Settings.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value private and stable; changing it makes previously saved keys unreadable.
FERNET_SECRET_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
